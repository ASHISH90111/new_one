<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>custom_astar_planner</name>
  <version>0.1.0</version>

  <description>
    Custom A* global planner plugin for ROS 2 Nav2 using Euclidean heuristic
    with diagonal motion support.
  </description>

  <maintainer email="abhi@todo.todo">abhi</maintainer>
  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS 2 -->
  <depend>rclcpp</depend>

  <!-- Nav2 interfaces -->
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>

  <!-- Plugin system -->
  <depend>pluginlib</depend>

  <!-- Messages -->
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- TF -->
  <depend>tf2_ros</depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- REQUIRED for Nav2 plugin discovery -->
  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/plugin.xml"/>
  </export>

</package>
